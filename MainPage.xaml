<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LabXml.MainPage"
             Title="Наукові роботи кафедри">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Button Text="Відкрити XML-файл..." Clicked="OnOpenFile"/>
            <Label x:Name="FileLabel" Text="Файл не вибрано" FontSize="12"/>

            <Label Text="Параметри пошуку (значення з файлу):" FontAttributes="Bold"/>
            <VerticalStackLayout x:Name="CriteriaPanel" Spacing="6"/>

            <Label Text="Спосіб аналізу:" FontAttributes="Bold"/>
            <Picker x:Name="StrategyPicker" SelectedIndexChanged="OnStrategyChanged"/>

            <HorizontalStackLayout Spacing="8">
                <Button Text="Пошук" Clicked="OnSearch"/>
                <Button Text="У HTML" Clicked="OnToHtml"/>
                <Button Text="Clear" Clicked="OnClear"/>
                <Button Text="Вихід" Clicked="OnExit"/>
            </HorizontalStackLayout>

            <Editor x:Name="Output" IsReadOnly="True" AutoSize="TextChanges" MinimumHeightRequest="250"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
